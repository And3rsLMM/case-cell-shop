# API Express
API_PORT=3333
WEB_ORIGIN=http://localhost:3000
JSON_BODY_LIMIT=32kb
ORDER_MAX_DISTINCT_ITEMS=20

# Simulação do ERP
# automatic, success, slow ou temporary-failure
ERP_SIMULATION_MODE=automatic
ERP_MIN_DELAY_MS=50
ERP_MAX_DELAY_MS=150
ERP_FAILURE_RATE=0
ERP_SYNC_TIMEOUT_MS=200
ERP_MAX_ATTEMPTS=3
ERP_PROCESSING_LEASE_MS=30000

# Prisma resolve caminhos SQLite relativamente a apps/api/prisma.
DATABASE_URL=file:./dev.db

# Variável pública usada pelo navegador para chamar diretamente o Express.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3333
