    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests --ext .ts"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "jest": "29.7.0",
    "ts-jest": "29.4.1"
  }
