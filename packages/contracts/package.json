{
  "name": "@case-cell-shop/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Contratos públicos compartilhados da CaseCellShop.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
